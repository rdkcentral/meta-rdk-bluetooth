+++ b/tools/hciattach_qualcomm.c
@@ -170,9 +170,11 @@ int qualcomm_init(int fd, int speed, str
 	unsigned char resp[100];		/* Response */
 	char fw[100];
 	int n;
+	fprintf(stderr, "%s\n", __func__);
 
 	memset(resp, 0, 100);
 
+#if 0
 	/* Get Manufacturer and LMP version */
 	cmd[0] = HCI_COMMAND_PKT;
 	cmd[1] = 0x01;
@@ -202,7 +204,7 @@ int qualcomm_init(int fd, int speed, str
 
 	/* Print LMP version */
 	fprintf(stderr,
-		"Qualcomm module LMP version : 0x%02x\n", resp[10] & 0xFF);
+		"1 Qualcomm module LMP version : 0x%02x\n", resp[10] & 0xFF);
 
 	/* Print LMP subversion */
 	{
@@ -269,6 +271,6 @@ int qualcomm_init(int fd, int speed, str
 	} while (resp[4] != cmd[1] && resp[5] != cmd[2]);
 
 	nanosleep(&tm, NULL);
-
+#endif
 	return 0;
 }
