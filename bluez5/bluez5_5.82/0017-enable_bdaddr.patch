Index: bluez-5.80/Makefile.tools
===================================================================
--- bluez-5.80.orig/Makefile.tools
+++ bluez-5.80/Makefile.tools
@@ -225,9 +225,9 @@ endif
 
 if TOOLS
 bin_PROGRAMS += tools/rctest tools/l2test tools/l2ping tools/bluemoon \
-		tools/hex2hcd tools/mpris-proxy tools/btattach tools/isotest
+		tools/hex2hcd tools/mpris-proxy tools/btattach tools/isotest tools/bdaddr
 
-noinst_PROGRAMS += tools/bdaddr tools/avinfo tools/avtest \
+noinst_PROGRAMS += tools/avinfo tools/avtest \
 			tools/scotest tools/hwdb \
 			tools/hcieventmask tools/hcisecfilter \
 			tools/btinfo tools/btconfig \
